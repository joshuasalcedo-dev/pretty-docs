<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.joshuasalcedo.pretty</groupId>
        <artifactId>pretty-docs-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>pretty-docs-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Pretty Docs Maven Plugin</name>
    <description>Generates a modern documentation site for single- and multi-module Maven projects</description>

    <prerequisites>
        <maven>3.9.0</maven>
    </prerequisites>

    <dependencies>
        <dependency>
            <groupId>io.joshuasalcedo.pretty</groupId>
            <artifactId>pretty-java</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.joshuasalcedo.pretty</groupId>
            <artifactId>pretty-maven</artifactId>
            <version>${revision}</version>
            <exclusions>
                <!-- provided by the Maven runtime -->
                <exclusion>
                    <groupId>org.apache.maven</groupId>
                    <artifactId>maven-model</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.joshuasalcedo.pretty</groupId>
            <artifactId>pretty-spring</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.joshuasalcedo.pretty</groupId>
            <artifactId>pretty-ts</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.joshuasalcedo.pretty</groupId>
            <artifactId>pretty-quality</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- The site template is prebuilt into src/main/resources/pretty-site (see ../pretty-site), so
             building and using the plugin needs no Node.js. -->

        <dependency>
            <groupId>net.sourceforge.plantuml</groupId>
            <artifactId>plantuml-mit</artifactId>
        </dependency>
        <!-- README rendering (same extension set as parser-utility's MarkdownParser) -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-autolink</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-heading-anchor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven-plugin-tools.version}</version>
                <configuration>
                    <goalPrefix>pretty-docs</goalPrefix>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
